# Copiar a /home/ventago/homelab/mysql-backup.env y completar.
# No va al repositorio.

VPS_HOST=reemplazar
VPS_USER=mysql-backup-pull
VPS_SSH_KEY=/home/ventago/.ssh/mysql-backup-pull
BACKUP_DIR=/home/ventago/backups/mysql
AGE_IDENTITY=/home/ventago/homelab/mysql-backup.key
KEEP_DAYS=35
MONTHLY_DAYS=366

# URLs de ping de Healthchecks. Los correos se configuran en esa cuenta.
HC_PULL_URL=https://hc-ping.com/reemplazar
HC_DUMP_URL=https://hc-ping.com/reemplazar
HC_RESTORE_URL=https://hc-ping.com/reemplazar
