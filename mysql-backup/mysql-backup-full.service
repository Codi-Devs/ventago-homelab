[Unit]
Description=Jala la foto cifrada de MySQL
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ventago
Environment=MYSQL_BACKUP_ENV=/home/ventago/homelab/mysql-backup.env
ExecStart=/home/ventago/homelab/orchestrator/mysql-backup/pull-full.sh
TimeoutStartSec=infinity
